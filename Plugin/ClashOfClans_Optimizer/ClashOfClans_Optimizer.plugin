#!name = COC 加速
#!desc = 部落冲突专用分流：9339 端口兜底 + Supercell 域名族，配合美东线路使用
#!author = 本地生成
#!icon =  https://store.supercell.com/public/app-icon-clashofclans-LR5OPSRT.png
#!system = iOS,iPadOS
#!loon_version = 3.1.7
#!tag = 游戏,加速
#!date = 2026-11-20
#!type = normal

[Rule]
# 游戏主连接：客户端自行解析 DNS 后直连 IP，无 SNI
# Loon 只能看到 IP 和端口，域名规则对这条连接无效，必须靠端口识别
DEST-PORT,9338-9340,PROXY

# 账号、登录与支付（HTTPS，SNI 可见）
DOMAIN-SUFFIX,supercell.net,PROXY
DOMAIN-SUFFIX,supercell.com,PROXY
DOMAIN-SUFFIX,supercellid.com,PROXY
DOMAIN-SUFFIX,supercellgames.com,PROXY

# Supercell 游戏域名族
DOMAIN-SUFFIX,clashofclans.com,PROXY
DOMAIN-SUFFIX,clashroyale.com,PROXY
DOMAIN-SUFFIX,brawlstars.com,PROXY
DOMAIN-SUFFIX,boombeach.com,PROXY
DOMAIN-SUFFIX,hayday.com,PROXY
DOMAIN-SUFFIX,superevilmegacorp.com,PROXY
